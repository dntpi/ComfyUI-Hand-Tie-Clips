__pycache__/
*.py[cod]

# Every source in this pack has .bak siblings -- the reflex that stands in for
# version control here. They are working files, not releases.
*.bak
*.bak*

# Session handover doc -- working file, never ships
HANDOVER.md

# `comfy node publish` builds this in the repo root. A build artifact, not a
# release -- it briefly got committed on 2026-08-30 because of a `git add -A`.
node.zip

# Local LLM connection settings -- a machine property, not a release.
htc_llm.json

# Session handover docs. Working notes between sessions -- they name renders,
# dead ends and machine specifics, and one of them is always the live queue.
# The root HANDOVER.md was already ignored; these are the same thing, dated.
docs/HANDOVER_*.md
.core_matrix_cache/

# Agent working files -- never ships
CLAUDE.md
.claude/

# Bench graphs. `workflows/` is a shipped directory, so anything dropped in it
# lands in a release -- and a bench graph wires nodes from packs a user has no
# reason to have installed (HandTieClips_PDD_Acc_Test.json needs
# `UC_MiniMaxH3PDDAcc`), so it loads broken for almost everyone.
# `tools/check_workflows.py` validates the two shipped files by name and would
# not catch it. Remove the line to ship one deliberately.
workflows/*_Test.json

# Handoff notes and editor/agent tool state -- working files, never ship.
docs/*HANDOFF*.md
docs/CLAUDE_*.md
docs/BRAINSTORM_*.md
RECAP_*.md
REFINE_V2_BUILD_PLAN.md
SPACE_BUNNY_FINDINGS.md
workflows/HandTieClips_HandTie_Vlog10_*.json
tools/head_probe.py
.serena/

# Development only, kept local since 3.0.0 (2026-10-18): the checker suite and
# pack builders, and the engineering history. Nothing here runs when the node
# loads, and the public repo is the node.
tools/
docs/DEVLOG.md
docs/LEVER_AUDIT.md
